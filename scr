**REGION SaveJD

SET in_strRequiredSkills TO $''''''
SET in_strAdditionalSkills TO $''''''
SET in_strJobDescription TO $''''''
SET in_strRequisitionID TO $''''''
Variables.CreateNewList List=> jdJsonArray
SET strJDList TO $''''''
SET newJD TO $''''''
SET intExists TO $''''''
SET intloopCount TO 0

# Activity: Property [Property]
# Activity: Property [Property]
# Activity: Property [Property]
# Activity: Property [Property]
# Activity: SaveJD.in_strRequiredSkills [SaveJD.in_strRequiredSkills]
# Activity: SaveJD.in_strAdditionalSkills [SaveJD.in_strAdditionalSkills]
# Activity: SaveJD.in_strJobDescription [SaveJD.in_strJobDescription]
# Activity: SaveJD.in_strRequisitionID [SaveJD.in_strRequisitionID]
# Activity: Null [Null]
# Activity: VirtualizedContainerService.HintSize [VirtualizedContainerService.HintSize]
# Activity: List [List]
# Activity: Variable [Variable]
# Activity: Variable [Variable]
# Activity: Variable [Variable]
# Activity: Variable [Variable]
File.ReadTextFromFile.ReadText File: $'''Data\config\JDList.json''' Encoding: File.TextFileEncoding.UTF8 Content=> strJDList
Variables.ConvertJsonToCustomObject Json: strJDList CustomObject=> jdJsonArray
LOOP WHILE True
    # Activity: Variable [Variable]
    # Activity: While.Condition [While.Condition]
    IF jdJsonArray.Item(intloopCount).Item['JD_Title'].ToUpper.Replace(" ","").Trim.Equals(in_strJobDescription.ToString.ToUpper.Replace(" ","").Trim) THEN
        SET Item['Requisition_ID'] TO in_strRequisitionID
        SET Item['Key_Skills'] TO in_strRequiredSkills
        SET Item['May_Know_Skills'] TO in_strAdditionalSkills
        SET intExists TO 1
    END
    SET intloopCount TO intloopCount + 1
END
IF intExists = 0 THEN
    Variables.ConvertJsonToCustomObject Json: jdJsonArray.ToString.Substring(0, jdJsonArray.ToString.Length - 1) + ", { 'JD_Title': '"+ in_strJobDescription +"', 'Key_Skills': '"+ in_strRequiredSkills +"', 'May_Know_Skills': '"+ in_strAdditionalSkills +"' } ]" CustomObject=> jdJsonArray
END
Folder.GetSpecialFolder SpecialFolder: Folder.SpecialFolder.DesktopDirectory SpecialFolderPath=> SpecialFolderPath
SET excelPath TO $'''%SpecialFolderPath%\Workbook.xlsx'''
File.WriteText File: $'''Data\config\JDList.json''' AppendNewLine: True IfFileExists: File.IfFileExists.Overwrite Encoding: File.FileEncoding.Unicode TextToWrite: $'''%jdJsonArray%'''
File.WriteText File: $'''Data\config\webjd.txt''' AppendNewLine: True IfFileExists: File.IfFileExists.Overwrite Encoding: File.FileEncoding.Unicode TextToWrite: $'''data = \'%jdJsonArray.Replace("
","")%\';'''
**ENDREGION
