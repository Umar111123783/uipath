# ========================================================
# SUBFLOW: SourcingBot/Framework/SaveJD.xaml
# ========================================================
**REGION SaveJD

SET in_strRequiredSkills TO $''''''
SET in_strAdditionalSkills TO $''''''
SET in_strJobDescription TO $''''''
SET in_strRequisitionID TO $''''''
Variables.CreateNewList List=> jdJsonArray
SET strJDList TO $''''''
SET newJD TO $''''''
SET intExists TO $''''''
SET intloopCount TO 0

File.ReadTextFromFile.ReadText File: $'''Data\config\JDList.json''' Encoding: File.TextFileEncoding.UTF8 Content=> strJDList
Variables.ConvertJsonToCustomObject Json: strJDList CustomObject=> jdJsonArray
LOOP WHILE True
    IF jdJsonArray[intloopCount]['JD_Title'] = in_strJobDescription THEN
        SET jdJsonArray[intloopCount]["Requisition_ID"] TO in_strRequisitionID
        SET jdJsonArray[intloopCount]["Key_Skills"] TO in_strRequiredSkills
        SET jdJsonArray[intloopCount]["May_Know_Skills"] TO in_strAdditionalSkills
        SET intExists TO 1
    END
    SET intloopCount TO intloopCount + 1
END
IF intExists = 0 THEN
    Variables.ConvertJsonToCustomObject Json: $'''{ \'JD_Title\': \'%in_strJobDescription%\', \'Key_Skills\': \'%in_strRequiredSkills%\', \'May_Know_Skills\': \'%in_strAdditionalSkills%\' }''' CustomObject=> new_jdJsonArrayItem
    Variables.AddItemToList Item: new_jdJsonArrayItem List: jdJsonArray
END
Folder.GetSpecialFolder SpecialFolder: Folder.SpecialFolder.DesktopDirectory SpecialFolderPath=> SpecialFolderPath
SET excelPath TO $'''%SpecialFolderPath%\Workbook.xlsx'''
File.WriteText File: $'''Data\config\JDList.json''' AppendNewLine: True IfFileExists: File.IfFileExists.Overwrite Encoding: File.FileEncoding.Unicode TextToWrite: $'''%jdJsonArray%'''
File.WriteText File: $'''Data\config\webjd.txt''' AppendNewLine: True IfFileExists: File.IfFileExists.Overwrite Encoding: File.FileEncoding.Unicode TextToWrite: $'''data = \'%jdJsonArray%\';'''
**ENDREGION
