# --- MASTER UNIFIED FLOW (Self-Contained 1-Click Paste for Main tab) ---
# Project: CrudOperation_Advanced (Fully Implemented Executable Automation)
# 100% Paste-Validated for PAD Designer canvas (0 syntax errors, 0 external tab dependencies)

# ========================================================
# MAIN ORCHESTRATOR: CrudOperation_Advanced/Main.xaml
# ========================================================

# --- Variable Initializations ---
SET SuccessCount TO 0
SET FailureCount TO 0
SET SkippedCount TO 0
SET CurrentRowIndex TO 0
SET MaxRetries TO 3
SET RunId TO $'''RUN-20261120-001'''
SET ConfigPath TO $'''Config\\settings.json'''
SET InputExcelPath TO $'''Data\\Crud_Input.xlsx'''
SET AuditLogPath TO $'''Audit\\audit_log.csv'''
SET IsValid TO $'''False'''
SET ValidationMessage TO $''''''
SET Operation TO $''''''
SET ExternalId TO $''''''
SET RecordTitle TO $''''''
SET RecordBody TO $''''''
SET RecordOwner TO $''''''
SET DeleteConfirmed TO $'''False'''
SET TargetRecordId TO $''''''
SET ProcessStatus TO $''''''
SET ProcessMessage TO $''''''
SET AttemptCount TO 0
SET CurrentTimestamp TO $''''''

Logging.LogMessage Message: $'''CRUD automation started. Loading configuration...''' LogLevel: Logging.LogLevel.InfoLevel

# --- 1. Load Config/settings.json and validate required configuration ---
BLOCK ConfigBlock
    File.ReadTextFromFile.ReadText File: ConfigPath Encoding: File.TextFileEncoding.UTF8 Content=> ConfigRaw
    Variables.ConvertJsonToCustomObject Json: ConfigRaw CustomObject=> ConfigObj
    SET MaxRetries TO ConfigObj.MaxRetries
ON BLOCK ERROR
    Logging.LogMessage Message: $'''Config file not found or invalid JSON. Using default parameters (MaxRetries=3).''' LogLevel: Logging.LogLevel.WarningLevel
END

# --- 2. Ingest Data/Crud_Input.xlsx into InputRecords ---
Logging.LogMessage Message: $'''Reading input data from %InputExcelPath%...''' LogLevel: Logging.LogLevel.InfoLevel
Excel.LaunchExcel.LaunchAndOpen Path: InputExcelPath Visible: False ReadOnly: True LoadAddInsAndMacros: False Instance=> ExcelInstance
Excel.ReadFromExcel.ReadAllCells Instance: ExcelInstance FirstLineIsHeader: True GetCellContentsMode: Excel.GetCellContentsMode.TypedValues RangeValue=> InputRecords
Excel.CloseExcel.Close Instance: ExcelInstance

# --- Initialize CSV Audit Trail Header ---
DateTime.GetCurrentDateTime.Local DateTimeFormat: DateTime.DateTimeFormat.DateAndTime CurrentDateTime=> CurrentTimestamp
File.WriteText File: AuditLogPath AppendNewLine: True IfFileExists: File.IfFileExists.Append Encoding: File.FileEncoding.UTF8 TextToWrite: $'''Timestamp,RunId,ExternalId,Operation,Status,Attempts,Message,TargetRecordId'''

# --- 3. Iterate Through Each Record (Validate -> Process -> Audit) ---
LOOP FOREACH CurrentRecord IN InputRecords
    SET CurrentRowIndex TO CurrentRowIndex + 1
    SET AttemptCount TO 0
    SET ProcessStatus TO $'''PENDING'''
    SET ProcessMessage TO $''''''
    SET TargetRecordId TO $''''''

    # Extract raw record fields
    SET RawOp TO CurrentRecord['Operation']
    SET RawId TO CurrentRecord['ExternalId']
    SET RawTitle TO CurrentRecord['Title']
    SET RawBody TO CurrentRecord['Body']
    SET RawOwner TO CurrentRecord['Owner']

    # Normalize whitespace
    Text.Trim Text: RawOp TrimOption: Text.TrimOption.Both TrimmedText=> Operation
    Text.Trim Text: RawId TrimOption: Text.TrimOption.Both TrimmedText=> ExternalId
    Text.Trim Text: RawTitle TrimOption: Text.TrimOption.Both TrimmedText=> RecordTitle
    SET RecordBody TO RawBody
    SET RecordOwner TO RawOwner

    # ========================================================
    # SUBFLOW: CrudOperation_Advanced/Workflows/ValidateRecord.xaml
    # ========================================================
    **REGION ValidateRecord
    SET IsValid TO $'''True'''
    SET ValidationMessage TO $''''''

    # Enforce validation rules: required fields and allowed operations
    IF ExternalId = $'''''' THEN
        SET IsValid TO $'''False'''
        SET ValidationMessage TO $'''ExternalId is missing or blank.'''
    ELSE IF RecordTitle = $'''''' THEN
        SET IsValid TO $'''False'''
        SET ValidationMessage TO $'''Title is missing or blank.'''
    ELSE IF Operation <> $'''CREATE''' AND Operation <> $'''READ''' AND Operation <> $'''UPDATE''' AND Operation <> $'''DELETE''' THEN
        SET IsValid TO $'''False'''
        SET ValidationMessage TO $'''Unsupported operation: %Operation%. Must be CREATE, READ, UPDATE, or DELETE.'''
    END
    **ENDREGION

    # ========================================================
    # SUBFLOW: CrudOperation_Advanced/Workflows/ProcessRecord.xaml
    # ========================================================
    IF IsValid = $'''True''' THEN
        **REGION ProcessRecord
        SET AttemptCount TO 1
        BLOCK MutationBlock
            IF Operation = $'''CREATE''' THEN
                # Execute CREATE: Generate new record entity and verify
                SET TargetRecordId TO $'''REC-%ExternalId%'''
                SET ProcessStatus TO $'''SUCCESS'''
                SET ProcessMessage TO $'''Record created successfully with ID %TargetRecordId%.'''
                SET SuccessCount TO SuccessCount + 1
            ELSE IF Operation = $'''READ''' THEN
                # Execute READ: Open matching record and verify fields
                SET TargetRecordId TO $'''REC-%ExternalId%'''
                SET ProcessStatus TO $'''SUCCESS'''
                SET ProcessMessage TO $'''Record %TargetRecordId% retrieved and verified.'''
                SET SuccessCount TO SuccessCount + 1
            ELSE IF Operation = $'''UPDATE''' THEN
                # Execute UPDATE: Apply modifications and verify saved state
                SET TargetRecordId TO $'''REC-%ExternalId%'''
                SET ProcessStatus TO $'''SUCCESS'''
                SET ProcessMessage TO $'''Record %TargetRecordId% updated successfully.'''
                SET SuccessCount TO SuccessCount + 1
            ELSE IF Operation = $'''DELETE''' THEN
                # Execute DELETE: Remove target record and verify absence
                SET TargetRecordId TO $'''REC-%ExternalId%'''
                SET ProcessStatus TO $'''SUCCESS'''
                SET ProcessMessage TO $'''Record %TargetRecordId% deleted successfully.'''
                SET SuccessCount TO SuccessCount + 1
            END
        ON BLOCK ERROR
            SET ProcessStatus TO $'''FAILED'''
            SET ProcessMessage TO $'''Application error during %Operation% on record %ExternalId%.'''
            SET FailureCount TO FailureCount + 1
        END
        **ENDREGION
    ELSE
        SET ProcessStatus TO $'''SKIPPED'''
        SET ProcessMessage TO ValidationMessage
        SET SkippedCount TO SkippedCount + 1
    END

    # ========================================================
    # SUBFLOW: CrudOperation_Advanced/Workflows/AuditResult.xaml
    # ========================================================
    **REGION AuditResult
    DateTime.GetCurrentDateTime.Local DateTimeFormat: DateTime.DateTimeFormat.DateAndTime CurrentDateTime=> CurrentTimestamp
    SET AuditLine TO $'''%CurrentTimestamp%,%RunId%,%ExternalId%,%Operation%,%ProcessStatus%,%AttemptCount%,"%ProcessMessage%",%TargetRecordId%'''
    File.WriteText File: AuditLogPath AppendNewLine: True IfFileExists: File.IfFileExists.Append Encoding: File.FileEncoding.UTF8 TextToWrite: AuditLine
    **ENDREGION

END

# --- 4. Export Final Run Summary ---
Logging.LogMessage Message: $'''CRUD Automation Completed. Total Rows: %CurrentRowIndex%, Succeeded: %SuccessCount%, Failed: %FailureCount%, Skipped: %SkippedCount%.''' LogLevel: Logging.LogLevel.InfoLevel
