  },
  "Data": {
    "components": [
      {
        "label": "Update Post Title",
        "tableView": true,
        "validate": {
          "minLength": 1,
          "maxLength": 50
        },
        "key": "updatePostTitle",
        "type": "textfield",
        "input": true
      },
      {
        "label": "Update Post Desc",
        "tableView": true,
        "validate": {
          "minLength": 1,
          "maxLength": 200
        },
        "key": "updatePostDesc",
        "type": "textfield",
        "input": true
      },
      {
        "type": "button",
        "label": "Submit",
        "key": "submit",
        "disableOnInvalid": true,
        "input": true,
        "tableView": false
      }
    ]
  }
